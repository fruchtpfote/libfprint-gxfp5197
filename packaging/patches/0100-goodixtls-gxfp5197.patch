diff --git a/tests/test-goodixtls.c b/tests/test-goodixtls.c
new file mode 100644
index 0000000..6a278bd
--- /dev/null
+++ b/tests/test-goodixtls.c
@@ -0,0 +1,175 @@
+/*
+ * Unit tests for the goodixtls driver's protocol helpers and model table
+ *
+ * Copyright (C) 2026 Matthias Gruss
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * Vectors are the ones the Python probe (tools/gxprobe) was tested with and
+ * that the GXFP5197 answered on the bench.
+ */
+
+#include <glib.h>
+
+#include "drivers/goodixtls/goodix_model.h"
+
+static void
+test_lookup_5197_13010 (void)
+{
+  const GxModel *m = gx_model_lookup ("GXFP5197", "GF3288_ST411SEC_APP_13010");
+
+  g_assert_nonnull (m);
+  g_assert_cmphex (m->psk_addr, ==, 0x20007f14);
+  g_assert_cmpuint (m->psk_len, ==, 48);
+  g_assert_cmphex (m->mem_bias, ==, 0x08000000);
+  g_assert_true (m->split_header);
+  g_assert_cmpuint (m->img_w, ==, 132);
+  g_assert_cmpuint (m->img_h, ==, 112);
+  g_assert_cmpuint (m->reset_line_default, ==, 58);
+  g_assert_cmpuint (m->config_len, ==, 256);
+  g_assert_true (gx_config_valid (m->config, m->config_len));
+}
+
+static void
+test_lookup_5187_11033 (void)
+{
+  const GxModel *m = gx_model_lookup ("GXFP5187", "GF3288_ST411SEC_APP_11033");
+
+  g_assert_nonnull (m);
+  g_assert_cmphex (m->psk_addr, ==, 0x20007f0c);
+  g_assert_false (m->split_header);
+}
+
+/* Unknown firmware must never get stage-B commands: no entry, no guessing. */
+static void
+test_lookup_unknown (void)
+{
+  g_assert_null (gx_model_lookup ("GXFP5197", "GF3288_ST411SEC_APP_99999"));
+  g_assert_null (gx_model_lookup ("GXFP9999", "GF3288_ST411SEC_APP_13010"));
+  g_assert_null (gx_model_lookup ("GXFP5197", ""));
+  g_assert_null (gx_model_lookup ("GXFP5197", NULL));
+}
+
+/* Before the firmware is known only the transport may be chosen. */
+static void
+test_transport (void)
+{
+  g_assert_true (gx_model_transport ("GXFP5197")->split_header);
+  g_assert_false (gx_model_transport ("GXFP5187")->split_header);
+  g_assert_null (gx_model_transport ("GXFP9999"));
+}
+
+static void
+test_body_cksum (void)
+{
+  static const guint8 b[] = { 0xa8, 0x03, 0x00, 0x70, 0xdc };
+
+  g_assert_cmphex (goodix_body_cksum (b, sizeof b), ==, 0xb3);
+}
+
+static void
+test_frame_header (void)
+{
+  guint8 h[4];
+
+  gx_frame_header (0xa0, 8, h);
+  g_assert_cmphex (h[0], ==, 0xa0);
+  g_assert_cmphex (h[1], ==, 0x08);
+  g_assert_cmphex (h[2], ==, 0x00);
+  g_assert_cmphex (h[3], ==, 0xa8);
+  gx_frame_header (0xb0, 0x1234, h);
+  g_assert_cmphex (h[3], ==, 0xf6);
+}
+
+static void
+test_decode_12bit (void)
+{
+  static const guint8 in[] = { 0x21, 0x43, 0x65, 0x87, 0xa9, 0xcb };
+  guint16 out[4] = { 0 };
+
+  gx_decode_12bit (in, sizeof in, out, 4);
+  g_assert_cmphex (out[0], ==, 0x143);
+  g_assert_cmphex (out[1], ==, 0x872);
+  g_assert_cmphex (out[2], ==, 0xb65);
+  g_assert_cmphex (out[3], ==, 0xa9c);
+}
+
+/* The image record is about 22 kB in one transfer; spidev's default 4096
+ * truncates it. */
+static void
+test_bufsiz (void)
+{
+  g_assert_false (gx_bufsiz_ok (4096));
+  g_assert_true (gx_bufsiz_ok (65536));
+}
+
+static void
+test_mem_read_cmd (void)
+{
+  const GxModel *m = gx_model_lookup ("GXFP5197", "GF3288_ST411SEC_APP_13010");
+  static const guint8 want[] = {
+    0xf2, 0x09, 0x00, 0x14, 0x7f, 0x00, 0x18, 0x30, 0x00, 0x00, 0x00
+  };
+  guint8 c[12];
+
+  gx_mem_read_cmd (m->psk_addr, m->psk_len, m->mem_bias, c);
+  g_assert_cmpmem (c, 11, want, sizeof want);
+  g_assert_cmphex (c[11], ==, goodix_body_cksum (want, sizeof want));
+}
+
+static void
+test_mem_reply (void)
+{
+  guint8 r[3 + 4 + 1] = { 0xf2, 0x05, 0x00, 1, 2, 3, 4 };
+  guint8 out[4] = { 0 };
+  static const guint8 want[] = { 1, 2, 3, 4 };
+
+  r[7] = goodix_body_cksum (r, 7);
+  g_assert_true (gx_mem_reply_parse (r, sizeof r, out, 4));
+  g_assert_cmpmem (out, 4, want, 4);
+
+  r[4] ^= 1;                                    /* checksum now wrong */
+  g_assert_false (gx_mem_reply_parse (r, sizeof r, out, 4));
+  r[4] ^= 1;
+  g_assert_false (gx_mem_reply_parse (r, sizeof r, out, 3));   /* length */
+  r[0] = 0xb0;                                  /* an ACK, not the data */
+  g_assert_false (gx_mem_reply_parse (r, sizeof r, out, 4));
+}
+
+static void
+test_config_valid (void)
+{
+  guint8 blk[256] = { 0x18 };
+  guint16 s = 0xa5a5;
+  int i;
+
+  for (i = 0; i < 254; i += 2)
+    s += blk[i] | (blk[i + 1] << 8);
+  s = -s;
+  blk[254] = s & 0xff;
+  blk[255] = s >> 8;
+  g_assert_true (gx_config_valid (blk, sizeof blk));
+  blk[10] ^= 1;
+  g_assert_false (gx_config_valid (blk, sizeof blk));
+  g_assert_false (gx_config_valid (blk, 255));
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/goodixtls/lookup/5197-13010", test_lookup_5197_13010);
+  g_test_add_func ("/goodixtls/lookup/5187-11033", test_lookup_5187_11033);
+  g_test_add_func ("/goodixtls/lookup/unknown", test_lookup_unknown);
+  g_test_add_func ("/goodixtls/lookup/transport", test_transport);
+  g_test_add_func ("/goodixtls/proto/body-cksum", test_body_cksum);
+  g_test_add_func ("/goodixtls/proto/frame-header", test_frame_header);
+  g_test_add_func ("/goodixtls/proto/decode-12bit", test_decode_12bit);
+  g_test_add_func ("/goodixtls/proto/bufsiz", test_bufsiz);
+  g_test_add_func ("/goodixtls/proto/mem-read-cmd", test_mem_read_cmd);
+  g_test_add_func ("/goodixtls/proto/mem-reply", test_mem_reply);
+  g_test_add_func ("/goodixtls/proto/config-valid", test_config_valid);
+
+  return g_test_run ();
+}
diff --git a/tests/test-udev-rules.sh b/tests/test-udev-rules.sh
new file mode 100755
index 0000000..07a9d59
--- /dev/null
+++ b/tests/test-udev-rules.sh
@@ -0,0 +1,23 @@
+#!/bin/sh -e
+# SPDX-License-Identifier: LGPL-2.1-or-later
+# Copyright (C) 2026 Matthias Gruss
+# Devices with a _CID (e.g. GXFP5197) have MODALIAS acpi:HID:CID:, so an
+# exact acpi:HID: match never binds spidev.
+
+if [ ! -x "$UDEV_RULES" ]; then
+    echo "E: UDEV_RULES (${UDEV_RULES}) unset or not executable."
+    exit 1
+fi
+
+rules=$($UDEV_RULES)
+
+if ! echo "$rules" | grep -q 'ENV{MODALIAS}=="acpi:GXFP5197:\*"'; then
+    echo "E: no spidev rule matching acpi:GXFP5197:* (HID with _CID)"
+    echo "$rules" | grep GXFP || true
+    exit 1
+fi
+
+if echo "$rules" | grep -q 'ENV{MODALIAS}=="acpi:[^"*]*:"'; then
+    echo "E: exact acpi:HID: match misses devices with a _CID"
+    exit 1
+fi
